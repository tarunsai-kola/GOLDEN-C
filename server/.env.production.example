NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/golden-circle-production?retryWrites=true&w=majority
JWT_SECRET=super_secure_production_jwt_secret_must_be_at_least_64_characters_long
JWT_EXPIRES_IN=7d
CLIENT_URL=https://thegoldencircle.io
CLOUDINARY_CLOUD_NAME=your_production_cloudinary_name
CLOUDINARY_API_KEY=your_production_cloudinary_key
CLOUDINARY_API_SECRET=your_production_cloudinary_secret
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM=notifications@thegoldencircle.io
