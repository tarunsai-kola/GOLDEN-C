# The Golden Circle — Frontend Environment Configuration

# In local development, leaving VITE_API_URL empty uses Vite's built-in /api proxy (port 5000)
# When deploying the frontend to Vercel, set this in your Vercel Project Settings to your deployed backend URL:
# Example: VITE_API_URL=https://golden-circle-api.vercel.app
VITE_API_URL=

# Socket URL for real-time messaging (leave empty to automatically mirror VITE_API_URL):
# Example: VITE_SOCKET_URL=https://golden-circle-api.vercel.app
VITE_SOCKET_URL=
